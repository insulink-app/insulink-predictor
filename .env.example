# Copy to .env (git-ignored). Used by BOTH docker compose (variable substitution)
# and the app when you run `uv run --env-file .env gf ...`.
#
# NOTE: these are throwaway local-dev credentials. Never commit real secrets.

# --- Postgres container (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=insulink
POSTGRES_DB=insulink
POSTGRES_PORT=5432

# --- How the app connects to the DB above ---
# The app normalises postgresql:// -> postgresql+psycopg:// on its own, so this
# plain URL is fine. Host is localhost because the container publishes 5432.
DATABASE_URL=postgresql://postgres:insulink@localhost:5432/insulink

# Alternatively, instead of DATABASE_URL you can set the parts individually:
# GF_PG__HOST=localhost
# GF_PG__PORT=5432
# GF_PG__DATABASE=insulink
# GF_PG__USER=postgres
# GF_PG__PASSWORD=insulink
