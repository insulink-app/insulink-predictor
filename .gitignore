# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# PG Dumps
*.sql

# Virtual environments
.venv

# Data (raw/interim/processed) — never committed (ROADMAP §2).
# Anchored to the repo root so it does NOT match the src/.../data/ subpackage.
/data/

# Experiment tracking
/mlruns/

# Per-user models: runtime output of the tune job / mounted Docker volume — never
# committed. Keep the directory (via .gitkeep) so the default MODELS_DIR exists.
/artifacts/*
!/artifacts/.gitkeep

# DB inspection dumps contain real user data samples — never commit
reports/db_inspection.json

# Secrets / local env (compose + app credentials)
.env

# OS / editor
.DS_Store

# Ad-hoc forecast curve outputs (vary per user/range/time)
reports/curves_*.png

# IntelliJ related
*.iml
